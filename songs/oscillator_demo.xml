<?xml version="1.0" encoding="UTF-8"?>
<!--
  Demo/listening song for the <padsynth>/<additive> oscillators and the
  hand-built library instruments (mellotron, additive piano). Every
  instrument here is constructed directly (envelope+padsynth/additive/
  tapeDegradation), not by referencing a GM taxonomy path - the one
  deliberate exception is the "guitarSf2" track in the final section,
  which exists specifically to compare the additive piano against a real
  SoundFont guitar, and needs an actual SoundFont loaded to be audible
  (silent/fallback-oscillator otherwise, which is harmless, just quiet).

  Render with:
    ./build/synth --render demo.wav songs/oscillator_demo.xml
  and scrub/listen against the <locators> below, or open it in the UI and
  use the arrangement overview's locator column (each marks ›).
-->
<song temperament="31edo" tempo="90" timeSignature="1/4" volume="1.0">
  <instruments>
    <!-- 0: PadSynth "keyboard" - a sparse, few-harmonic piano-like tone
         with a percussive envelope (near-instant attack, decaying all the
         way to silence, no sustain plateau) - long enough (2.0s) to stay
         audible across this file's 6-row-held-chord convention. Used
         first for the chord-testing sections since it's the clearest,
         most keys-like tone to judge a chord by. -->
    <envelope id="i1" name="PadSynth Keyboard" attack="0.005" hold="0" decay="2.0" sustain="0.0" release="0.3">
      <padsynth preset="keyboard"/>
    </envelope>
    <!-- 2: PadSynth "bells-3", a narrow-band bell-like tone. -->
    <envelope id="i3" name="PadSynth Bells 3" attack="0.05" hold="0" decay="0.6" sustain="0.7" release="1.0">
      <padsynth preset="bells-3"/>
    </envelope>
    <!-- 3: PadSynth "dual-strings", a wide-band single-partial tone. -->
    <envelope id="i4" name="PadSynth Dual Strings (wide)" attack="0.05" hold="0" decay="0.6" sustain="0.7" release="1.0">
      <padsynth preset="dual-strings"/>
    </envelope>
    <!-- 4: PadSynth "choir-pad4" -->
    <envelope id="i5" name="PadSynth Choir Pad4" attack="0.4" hold="0" decay="0.4" sustain="0.85" release="1.0">
      <padsynth preset="choir-pad4"/>
    </envelope>
    <!-- 5: PadSynth "strings" - a simple, near-octave-doubled bowed
         string tone. -->
    <envelope id="i6" name="PadSynth Strings" attack="0.3" hold="0" decay="0.4" sustain="0.85" release="0.8">
      <padsynth preset="strings"/>
    </envelope>
    <!-- 6: PadSynth "bells" -->
    <envelope id="i7" name="PadSynth Bells" attack="0.02" hold="0" decay="0.8" sustain="0.5" release="1.2">
      <padsynth preset="bells"/>
    </envelope>
    <!-- 7: Additive "default" - a plain single string -->
    <envelope id="i8" name="Additive Default" attack="0.005" hold="0" decay="1.5" sustain="0.3" release="0.5">
      <additive preset="default"/>
    </envelope>
    <!-- 8: Mellotron - tape machine wrapping envelope+padsynth(strings): a
         Mellotron "strings" tape is a recording of a bowed string
         ensemble, the same real-world instrument family as "strings". -->
    <tapeDegradation id="i9" name="Mellotron" preset="mellotron">
      <envelope attack="0.05" hold="0" decay="0.3" sustain="0.95" release="0.4">
        <padsynth preset="strings"/>
      </envelope>
    </tapeDegradation>
    <!-- 9: Additive piano - sustain 0, long decay so it never truncates the
         additive engine's own per-partial decay, short release. The piano
         preset as src/instruments/InstrumentLibrary.cpp registers it, plus
         audition values for the stereo image (bass left to treble right,
         strings a degree apart). -->
    <envelope id="i10" name="Additive Piano" attack="0.005" hold="0" decay="8.0" sustain="0.0" release="0.3">
      <additive preset="piano" keyboardSpread="40" stringSpread="1"/>
    </envelope>
    <!-- 10: A real SoundFont guitar, for the unison comparison at the end -
         the one instrument here not built directly. -->
    <instrument id="i11" name="SoundFont Guitar" from="guitar.acoustic.steel"/>
    <!-- 11: PadSynth "strings" - moved
         here (was instrument 0) once instrument 0's own chord-testing slot
         was given to the new "keyboard" preset instead. -->
    <envelope id="i12" name="PadSynth Strings (chords)" attack="0.05" hold="0" decay="0.6" sustain="0.7" release="1.0">
      <padsynth preset="strings"/>
    </envelope>
    <!-- 12: choir-pad4 as a three-voice ensemble - one copy 8 cents flat,
         one in tune, one 8 cents sharp - for genuine ensemble-of-singers
         beating, which a single static table can't produce on its own. -->
    <envelope id="i13" name="PadSynth Choir Pad4" attack="0.4" hold="0" decay="0.4" sustain="0.85" release="1.0">
      <group>
        <padsynth preset="choir-pad4" detune="-8"/>
        <padsynth preset="choir-pad4"/>
        <padsynth preset="choir-pad4" detune="8"/>
      </group>
    </envelope>
    <!-- 13: reserved - was a second, "ooh" vowel variant (choir-pad4-ooh);
         pulled since it didn't actually read as a distinct vowel, to be
         redone properly later. Silent for now (empty pattern below), kept
         as a valid instrument (a plain copy of instrument 12's own
         choir-pad4) rather than left referencing the removed preset. -->
    <envelope id="i14" name="PadSynth Choir Pad4 (reserved)" attack="0.4" hold="0" decay="0.4" sustain="0.85" release="1.0">
      <group>
        <padsynth preset="choir-pad4" detune="-8"/>
        <padsynth preset="choir-pad4"/>
        <padsynth preset="choir-pad4" detune="8"/>
      </group>
    </envelope>

    <!-- 14-19: a further set of PadSynth character presets, each placed
         next to a plain envelope so its own spectral shape is easy to
         judge in isolation. -->

    <!-- 14: "Soft Pad" - a single pure partial, no upper harmonics at all -
         "soft" in the most literal spectral sense. -->
    <envelope id="i15" name="PadSynth Soft Pad" attack="0.8" hold="0" decay="0.3" sustain="0.9" release="1.5">
      <padsynth preset="soft-pad"/>
    </envelope>

    <!-- 16: "Dual Strings" - the strings tone doubled an octave up
         (detune="1200" cents) at half level. -->
    <envelope id="i17" name="PadSynth Dual Strings" attack="0.4" hold="0" decay="0.3" sustain="0.9" release="0.7">
      <group>
        <padsynth preset="strings"/>
        <padsynth preset="strings" detune="1200" level="0.5"/>
      </group>
    </envelope>

    <!-- 17: "Saw Piano" - a sustained "piano pad" character (holds at a
         substantial level rather than decaying to silence), unlike
         instrument 0's own percussive "keyboard" tone or instrument 9's
         additive piano (true per-partial decay) - three different takes
         on "piano". -->
    <envelope id="i18" name="PadSynth Saw Piano" attack="0.005" hold="0" decay="0.3" sustain="0.85" release="0.4">
      <padsynth preset="saw-piano"/>
    </envelope>

    <!-- 18: "Phased Choir" - choir-pad4 wrapped directly in <phaser>, a
         faster and more obvious sweep than pad.halo's own slow-shimmer
         combination - the phaser itself is the point of comparison here.
         See docs/effects.md for <phaser>'s own attributes. -->
    <phaser id="i19" name="PadSynth Phased Choir" stages="8" rate="0.35" minFreq="250" maxFreq="3000" feedback="0.5" mix="0.6">
      <envelope attack="0.4" hold="0" decay="0.4" sustain="0.85" release="1.0">
        <padsynth preset="choir-pad4"/>
      </envelope>
    </phaser>

    <!-- 19: "Church Organ" - a sparse drawbar-organ-style harmonic stack.
         Referenced directly (not through the taxonomy path, so this plays
         even when a real SoundFont organ is loaded and would otherwise
         win at organ.pipe itself). -->
    <envelope id="i20" name="PadSynth Organ Pipe" attack="0.015" hold="0" decay="0.05" sustain="1.0" release="0.08">
      <padsynth preset="church-organ"/>
    </envelope>

    <!-- 20: Synth Brass - referenced straight from the library
         (InstrumentLibrary.cpp's own brass.synth registration), not
         rebuilt here, since it's a plain preset+envelope
         combination with nothing song-specific to demonstrate on top -
         unlike the additive piano/choir above, there's no divergent-copy
         risk to keep in sync by hand. -->
    <instrument id="i21" name="PadSynth Synth Brass" from="brass.synth"/>
  </instruments>

  <tracks>
    <track id="0" name="PadSynth Keyboard" instrument="i1"/>
    <track id="2" name="PadSynth Bells 3" instrument="i3"/>
    <track id="3" name="PadSynth Dual Strings (wide)" instrument="i4"/>
    <track id="4" name="PadSynth Choir Pad4" instrument="i5"/>
    <track id="5" name="PadSynth Strings" instrument="i6"/>
    <track id="6" name="PadSynth Bells" instrument="i7"/>
    <track id="7" name="Additive Struck-String" instrument="i8"/>
    <track id="8" name="Mellotron" instrument="i9"/>
    <track id="9" name="Additive Piano" instrument="i10"/>
    <track id="10" name="SoundFont Guitar" instrument="i11"/>
    <track id="11" name="PadSynth Strings (chords)" instrument="i12"/>
    <track id="12" name="PadSynth Choir Pad4 (unison)" instrument="i13"/>
    <track id="13" name="PadSynth Choir Pad4 (reserved)" instrument="i14"/>
    <track id="14" name="PadSynth Soft Pad" instrument="i15"/>
    <track id="16" name="PadSynth Dual Strings" instrument="i17"/>
    <track id="17" name="PadSynth Saw Piano" instrument="i18"/>
    <track id="18" name="PadSynth Phased Choir" instrument="i19"/>
    <track id="19" name="PadSynth Organ Pipe" instrument="i20"/>
    <track id="20" name="PadSynth Synth Brass" instrument="i21"/>
  </tracks>

  <locators>
    <locator row="0">PadSynth keyboard - single note</locator>
    <locator row="8">PadSynth keyboard - sustained fifth</locator>
    <locator row="16">PadSynth keyboard - 31-EDO C-E-G triad</locator>
    <locator row="24">PadSynth keyboard - C-E-G-A♯ harmonic 7th</locator>
    <locator row="32">Additive default string - single note</locator>
    <locator row="40">Additive default string - sustained fifth</locator>
    <locator row="48">Additive default string - 31-EDO C-E-G triad</locator>
    <locator row="56">Additive default string - C-E-G-A♯ harmonic 7th</locator>
    <locator row="64">Mellotron (tape+padsynth) - single note</locator>
    <locator row="72">Mellotron (tape+padsynth) - sustained fifth</locator>
    <locator row="80">Mellotron (tape+padsynth) - 31-EDO C-E-G triad</locator>
    <locator row="88">Mellotron (tape+padsynth) - C-E-G-A♯ harmonic 7th</locator>
    <locator row="96">PadSynth "Bells 3", a narrow-band tone - triad, compare to row 104</locator>
    <locator row="104">PadSynth "Dual Strings" (wide), a wide-band tone - triad, compare to row 96</locator>
    <locator row="112">PadSynth "Choir Pad4" - single note</locator>
    <locator row="120">PadSynth strings - single note</locator>
    <locator row="128">PadSynth "Bells" - single note</locator>
    <locator row="136">Additive piano in unison with SoundFont guitar</locator>
    <locator row="144">PadSynth strings - single note</locator>
    <locator row="152">PadSynth strings - sustained fifth</locator>
    <locator row="160">PadSynth strings - 31-EDO C-E-G triad</locator>
    <locator row="168">PadSynth strings - C-E-G-A♯ harmonic 7th</locator>
    <locator row="176">PadSynth choir-pad4 - single note (track 13 reserved, silent for now)</locator>
    <locator row="192">PadSynth "Soft Pad" - single note</locator>
    <locator row="200">PadSynth "Dual Strings" (octave-doubled) - single note</locator>
    <locator row="208">PadSynth "Saw Piano" - single note</locator>
    <locator row="216">PadSynth "Phased Choir" (choir-pad4 + phaser) - single note</locator>
    <locator row="224">PadSynth "Church Organ" (organ-pipe) - single note</locator>
    <locator row="232">PadSynth "Synth Brass" (brass.synth) - single note</locator>
  </locators>

  <arrangement>
    <!-- PadSynth keyboard (rows 0-31) -->
    <pattern track="0">
      <note row="0" value="C-4"/>
      <note row="6" value="off"/>
      <note row="8">C-4 G-4</note>
      <note row="14">off off</note>
      <note row="16">C-4 E-4 G-4</note>
      <note row="22">off off off</note>
      <note row="24">C-4 E-4 G-4 A♯4</note>
      <note row="30">off off off off</note>
    </pattern>

    <!-- Additive default string (rows 32-63) -->
    <pattern track="7">
      <note row="32" value="C-4"/>
      <note row="38" value="off"/>
      <note row="40">C-4 G-4</note>
      <note row="46">off off</note>
      <note row="48">C-4 E-4 G-4</note>
      <note row="54">off off off</note>
      <note row="56">C-4 E-4 G-4 A♯4</note>
      <note row="62">off off off off</note>
    </pattern>

    <!-- Mellotron (rows 64-95) -->
    <pattern track="8">
      <note row="64" value="C-4"/>
      <note row="70" value="off"/>
      <note row="72">C-4 G-4</note>
      <note row="78">off off</note>
      <note row="80">C-4 E-4 G-4</note>
      <note row="86">off off off</note>
      <note row="88">C-4 E-4 G-4 A♯4</note>
      <note row="94">off off off off</note>
    </pattern>

    <!-- PadSynth Bells 3, narrow-band - triad only (rows 96-103) -->
    <pattern track="2">
      <note row="96">C-4 E-4 G-4</note>
      <note row="102">off off off</note>
    </pattern>

    <!-- PadSynth Dual Strings (wide), wide-band - triad only (rows 104-111) -->
    <pattern track="3">
      <note row="104">C-4 E-4 G-4</note>
      <note row="110">off off off</note>
    </pattern>

    <!-- PadSynth Choir Pad4 - single note (rows 112-119) -->
    <pattern track="4">
      <note row="112" value="C-4"/>
      <note row="118" value="off"/>
    </pattern>

    <!-- PadSynth strings - single note (rows 120-127) -->
    <pattern track="5">
      <note row="120" value="C-4"/>
      <note row="126" value="off"/>
    </pattern>

    <!-- PadSynth Bells - single note (rows 128-135) -->
    <pattern track="6">
      <note row="128" value="C-4"/>
      <note row="134" value="off"/>
    </pattern>

    <!-- Additive piano in unison with the SoundFont guitar (rows 136-143) -
         the same short ascending phrase on both tracks simultaneously. -->
    <pattern track="9">
      <note row="136" value="C-4"/>
      <note row="138" value="D-4"/>
      <note row="140" value="E-4"/>
      <note row="142" value="G-4"/>
    </pattern>
    <pattern track="10">
      <note row="136" value="C-4"/>
      <note row="138" value="D-4"/>
      <note row="140" value="E-4"/>
      <note row="142" value="G-4"/>
    </pattern>

    <!-- PadSynth strings (rows 144-175) - moved from track 0 -->
    <pattern track="11">
      <note row="144" value="C-4"/>
      <note row="150" value="off"/>
      <note row="152">C-4 G-4</note>
      <note row="158">off off</note>
      <note row="160">C-4 E-4 G-4</note>
      <note row="166">off off off</note>
      <note row="168">C-4 E-4 G-4 A♯4</note>
      <note row="174">off off off off</note>
    </pattern>

    <!-- Choir Pad4 (rows 176-191; track 13 - reserved for a future "ooh"
         variant - stays silent, no notes) -->
    <pattern track="12">
      <note row="176" value="C-4"/>
      <note row="182" value="off"/>
    </pattern>

    <!-- Further PadSynth character presets (rows 192-239) -->
    <pattern track="14">
      <note row="192" value="C-4"/>
      <note row="198" value="off"/>
    </pattern>
    <pattern track="16">
      <note row="200" value="C-4"/>
      <note row="206" value="off"/>
    </pattern>
    <pattern track="17">
      <note row="208" value="C-4"/>
      <note row="214" value="off"/>
    </pattern>
    <pattern track="18">
      <note row="216" value="C-4"/>
      <note row="222" value="off"/>
    </pattern>
    <pattern track="19">
      <note row="224" value="C-4"/>
      <note row="230" value="off"/>
    </pattern>
    <pattern track="20">
      <note row="232" value="C-4"/>
      <note row="238" value="off"/>
    </pattern>
  </arrangement>
</song>
