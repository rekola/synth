<?xml version="1.0" encoding="UTF-8"?>
<!--
  Demo/listening song for the <padsynth>/<additive> oscillators and the
  hand-built library instruments (mellotron, additive piano). Every
  instrument here is constructed directly (envelope+padsynth/additive/
  tapeDegradation), not by referencing a GM taxonomy path - the one
  deliberate exception is the "guitarSf2" track in the final section,
  which exists specifically to compare the additive piano against a real
  SoundFont guitar, and needs an actual SoundFont loaded to be audible
  (silent/fallback-oscillator otherwise, which is harmless, just quiet).

  Render with:
    ./build/synth --render demo.wav songs/oscillator_demo.xml
  and scrub/listen against the <locators> below, or open it in the UI and
  use the arrangement overview's locator column (each marks ›).
-->
<song temperament="31edo" tempo="90" rowsPerBar="4" volume="1.0">
  <instruments>
    <!-- 0: PadSynth "keyboard" - a static-spectrum, envelope-shaped "keys"
         character (comparison point against the additive piano's own true
         per-partial decay), used first for the chord-testing sections
         since it's the clearest/most keys-like tone to judge a chord by. -->
    <envelope name="PadSynth Keyboard" attack="0.01" hold="0" decay="1.5" sustain="0.15" release="0.3">
      <padsynth preset="keyboard"/>
    </envelope>
    <!-- 1: PadSynth "warm", tuning-matched OFF - A/B against instrument 11
         (PadSynth warm, tuning-matched ON, moved to the end of this file) -->
    <envelope name="PadSynth Warm (unmatched)" attack="0.05" hold="0" decay="0.6" sustain="0.7" release="1.0">
      <padsynth preset="warm" tuningMatched="false"/>
    </envelope>
    <!-- 2: PadSynth "warm", narrow bandwidth (8 cents) -->
    <envelope name="PadSynth Warm (narrow)" attack="0.05" hold="0" decay="0.6" sustain="0.7" release="1.0">
      <padsynth preset="warm" bandwidth="8"/>
    </envelope>
    <!-- 3: PadSynth "warm", wide bandwidth (80 cents - 150 was tried first
         and read as mostly noise even after the bandwidth-anchoring fix:
         at that width even the fundamental's own band is ~9% of its own
         frequency wide, smearing the most important partial before rolloff
         even gets a say) -->
    <envelope name="PadSynth Warm (wide)" attack="0.05" hold="0" decay="0.6" sustain="0.7" release="1.0">
      <padsynth preset="warm" bandwidth="80"/>
    </envelope>
    <!-- 4: PadSynth "formant-vocal" -->
    <envelope name="PadSynth Formant-Vocal" attack="0.4" hold="0" decay="0.4" sustain="0.85" release="1.0">
      <padsynth preset="formant-vocal"/>
    </envelope>
    <!-- 5: PadSynth "bowed-ensemble" -->
    <envelope name="PadSynth Bowed-Ensemble" attack="0.3" hold="0" decay="0.4" sustain="0.85" release="0.8">
      <padsynth preset="bowed-ensemble"/>
    </envelope>
    <!-- 6: PadSynth "glass" -->
    <envelope name="PadSynth Glass" attack="0.02" hold="0" decay="0.8" sustain="0.5" release="1.2">
      <padsynth preset="glass"/>
    </envelope>
    <!-- 7: Additive "struck-string" -->
    <envelope name="Additive Struck-String" attack="0.005" hold="0" decay="1.5" sustain="0.3" release="0.5">
      <additive preset="struck-string"/>
    </envelope>
    <!-- 8: Mellotron - tape machine wrapping envelope+padsynth(mellotron) -->
    <tapeDegradation name="Mellotron" preset="mellotron">
      <envelope attack="0.05" hold="0" decay="0.3" sustain="0.95" release="0.4">
        <padsynth preset="mellotron"/>
      </envelope>
    </tapeDegradation>
    <!-- 9: Additive piano - sustain 0, long decay so it never truncates the
         additive engine's own per-partial decay, short release. Overrides
         on top of struck-string (3-voice unison for a piano's own doubled/
         tripled strings per note, quieter/duller hammer attack, brighter
         tilt) matching src/instruments/InstrumentLibrary.cpp's own
         registerLibraryInstruments() - this song builds instruments
         directly rather than referencing that registration, so the two
         copies must be kept in sync by hand. -->
    <envelope name="Additive Piano" attack="0.005" hold="0" decay="8.0" sustain="0.0" release="0.3">
      <additive preset="struck-string" unisonVoices="3" attackNoiseLevel="0.04" tilt="-6"/>
    </envelope>
    <!-- 10: A real SoundFont guitar, for the unison comparison at the end -
         the one instrument here not built directly. -->
    <instrument name="SoundFont Guitar" from="guitar.acoustic.steel"/>
    <!-- 11: PadSynth "warm", tuning-matched partials (default) - moved here
         (was instrument 0) once instrument 0's own chord-testing slot was
         given to the new "keyboard" preset instead. -->
    <envelope name="PadSynth Warm" attack="0.05" hold="0" decay="0.6" sustain="0.7" release="1.0">
      <padsynth preset="warm"/>
    </envelope>
    <!-- 12/13: choir-aah vs choir-ooh, back to back - two genuinely
         different vowels (not just a renamed copy of each other, see
         PadSynthPresets.h): choir-aah is the same open "ah" formant shape
         instrument 4 above already used under the "formant-vocal" name;
         choir-ooh has its own lower, closer-together formants and a
         darker base spectrum for a rounded "oo" character. Both wrapped in
         <multiply unisons="3"> - a single static PADsynth table can't
         produce genuine ensemble-of-singers beating on its own (see
         PadSynthPresets.h's own bowed-ensemble comment); real independent,
         slightly-detuned unison voices are what src/instruments/
         InstrumentLibrary.cpp's own pad.choir/pad.choir.ooh
         registrations now use for exactly this reason, so this song
         mirrors it rather than sounding thinner than the library version -
         kept in sync by hand, same as the additive piano above. -->
    <multiply name="PadSynth Choir Aah" unisons="3" detune="16" spread="0.5">
      <envelope attack="0.4" hold="0" decay="0.4" sustain="0.85" release="1.0">
        <padsynth preset="choir-aah"/>
      </envelope>
    </multiply>
    <multiply name="PadSynth Choir Ooh" unisons="3" detune="16" spread="0.5">
      <envelope attack="0.4" hold="0" decay="0.4" sustain="0.85" release="1.0">
        <padsynth preset="choir-ooh"/>
      </envelope>
    </multiply>

    <!-- 14-19: reference points for real ZynAddSubFX factory patches
         (checked as example data for this project, per docs/padsynth.md's
         own "Formant boost"/"Known limitations" sections) - none of these
         are attempts at faithful recreations (their own real character
         mostly comes from an explicit per-harmonic array this codebase
         doesn't have - see those docs sections), just a same-family
         PadSynth combination placed alongside its named inspiration so
         the two are easy to compare by ear. -->

    <!-- 14: "Soft Pad" - warm's own gentle rolloff, slower/softer envelope
         than instrument 11's own plain "PadSynth Warm" for a gentler
         onset. -->
    <envelope name="PadSynth Soft Pad" attack="1.2" hold="0" decay="0.5" sustain="0.9" release="1.8">
      <padsynth preset="warm" bandwidth="14"/>
    </envelope>

    <!-- 15: "Bells" - real ported data now (PadSynthPresets.h's own
         kBells), not a retuned Glass: the uploaded ZynAddSubFX factory
         patch "Bells" has just 3 explicit harmonics (1/2/4), everything
         else silent - a real bell/chime's own small handful of dominant
         partials, which is what actually makes it read as a bell rather
         than a generic tone. tuningMatched=false on top, same reasoning
         as pad.metallic's own registration (InstrumentLibrary.cpp) - a
         real bell's overtones are non-integer, and exact-integer harmonics
         read as "out of tune"/dissonant against this engine's own
         scale-quantized tuning the same way. Compare to instrument 6's
         own plain (tuning-matched, smooth-rolloff) Glass. -->
    <envelope name="PadSynth Bells" attack="0.02" hold="0" decay="1.0" sustain="0.3" release="1.5">
      <padsynth preset="bells" tuningMatched="false"/>
    </envelope>

    <!-- 16: "Dual Strings Oct2" - bowed-ensemble wrapped in
         <multiply octaves="1">, real octave-doubled voices (not just a
         wider Gaussian band) - the "Oct2" in the real patch's own name
         is exactly this: a second layer an octave up/down from the
         first. -->
    <multiply name="PadSynth Dual Strings" octaves="1" detune="6">
      <envelope attack="0.4" hold="0" decay="0.3" sustain="0.9" release="0.7">
        <padsynth preset="bowed-ensemble"/>
      </envelope>
    </multiply>

    <!-- 17: "Saw Piano" - a bright, sawtooth-like rolloff (1.0, gentler
         than every other preset here) with a piano-style percussive
         envelope (no sustain plateau, long decay so PADsynth's own
         time-invariant spectrum - no true per-partial decay the way
         instrument 9's additive piano has - still reads as struck, not
         held). A deliberate comparison point against the additive piano:
         same "keyboard, percussive" idea, a completely different
         synthesis engine under it. -->
    <envelope name="PadSynth Saw Piano" attack="0.005" hold="0" decay="2.5" sustain="0.0" release="0.3">
      <padsynth preset="warm" bandwidth="10" bandwidthScale="0.4" partials="40"/>
    </envelope>

    <!-- 18: "Long SpaceChoir2" - choir-aah wrapped directly in <phaser>
         (a faster, more obvious sweep than pad.halo's own slow-shimmer
         combination, InstrumentLibrary.cpp - that one aims for a subtle
         background texture; this one is the phaser itself as the point of
         comparison). See docs/effects.md for <phaser>'s own attributes. -->
    <phaser name="PadSynth Phased Choir" stages="8" rate="0.35" minFreq="250" maxFreq="3000" feedback="0.5" mix="0.6">
      <envelope attack="0.4" hold="0" decay="0.4" sustain="0.85" release="1.0">
        <padsynth preset="choir-aah"/>
      </envelope>
    </phaser>

    <!-- 19: "Church Organ 3" - real ported data now (PadSynthPresets.h's
         own kChurchOrgan: an explicit, sparse harmonic array - 1/2/4/8/
         12/16/24/32 only - taken directly from the uploaded ZynAddSubFX
         factory patch, not the earlier from-scratch "organ-pipe"
         approximation). Referenced directly (not through the taxonomy
         path, so this plays even when a real SoundFont organ is loaded
         and would otherwise win at organ.pipe itself - see
         InstrumentLibrary.cpp's own registerFallbackPath() comment on
         that fallback). -->
    <envelope name="PadSynth Organ Pipe" attack="0.015" hold="0" decay="0.05" sustain="1.0" release="0.08">
      <padsynth preset="church-organ"/>
    </envelope>

    <!-- 20: Synth Brass - referenced straight from the library
         (InstrumentLibrary.cpp's own brass.synth registration), not
         rebuilt here, since it's a plain preset+envelope+multiply
         combination with nothing song-specific to demonstrate on top -
         unlike the additive piano/choir above, there's no divergent-copy
         risk to keep in sync by hand. -->
    <instrument name="PadSynth Synth Brass" from="brass.synth"/>

    <!-- 21: "PadSynth Saw Piano (unmatched)" - instrument 17's own exact
         preset, tuningMatched="false" only - the same paired-instrument
         shape instrument 1/11 ("PadSynth Warm (unmatched)"/"PadSynth
         Warm") already established at the top of this file, applied to
         the synth piano instead: a tuningMatched A/B on a genuinely
         piano-like PadSynth voice, not just a generic pad, and on chords
         a plain triad can't fully make the point with - see the new
         locators/patterns below (rows 280-325) for quartal triads that
         actually stress tuningMatched's own partial-snapping behavior. -->
    <envelope name="PadSynth Saw Piano (unmatched)" attack="0.005" hold="0" decay="2.5" sustain="0.0" release="0.3">
      <padsynth preset="warm" bandwidth="10" bandwidthScale="0.4" partials="40" tuningMatched="false"/>
    </envelope>
  </instruments>

  <tracks>
    <track id="0" name="PadSynth Keyboard" instrument="0"/>
    <track id="1" name="PadSynth Warm (unmatched)" instrument="1"/>
    <track id="2" name="PadSynth Warm (narrow)" instrument="2"/>
    <track id="3" name="PadSynth Warm (wide)" instrument="3"/>
    <track id="4" name="PadSynth Formant-Vocal" instrument="4"/>
    <track id="5" name="PadSynth Bowed-Ensemble" instrument="5"/>
    <track id="6" name="PadSynth Glass" instrument="6"/>
    <track id="7" name="Additive Struck-String" instrument="7"/>
    <track id="8" name="Mellotron" instrument="8"/>
    <track id="9" name="Additive Piano" instrument="9"/>
    <track id="10" name="SoundFont Guitar" instrument="10"/>
    <track id="11" name="PadSynth Warm" instrument="11"/>
    <track id="12" name="PadSynth Choir Aah" instrument="12"/>
    <track id="13" name="PadSynth Choir Ooh" instrument="13"/>
    <track id="14" name="PadSynth Soft Pad" instrument="14"/>
    <track id="15" name="PadSynth Bells" instrument="15"/>
    <track id="16" name="PadSynth Dual Strings" instrument="16"/>
    <track id="17" name="PadSynth Saw Piano" instrument="17"/>
    <track id="18" name="PadSynth Phased Choir" instrument="18"/>
    <track id="19" name="PadSynth Organ Pipe" instrument="19"/>
    <track id="20" name="PadSynth Synth Brass" instrument="20"/>
    <track id="21" name="PadSynth Saw Piano (unmatched)" instrument="21"/>
  </tracks>

  <locators>
    <locator row="0">PadSynth keyboard - single note</locator>
    <locator row="8">PadSynth keyboard - sustained fifth</locator>
    <locator row="16">PadSynth keyboard - 31-EDO C-E-G triad</locator>
    <locator row="24">PadSynth keyboard - C-E-G-A# harmonic 7th</locator>
    <locator row="32">PadSynth warm (tuningMatched=OFF) - single note</locator>
    <locator row="40">PadSynth warm (tuningMatched=OFF) - sustained fifth</locator>
    <locator row="48">PadSynth warm (tuningMatched=OFF) - 31-EDO C-E-G triad</locator>
    <locator row="56">PadSynth warm (tuningMatched=OFF) - C-E-G-A# harmonic 7th</locator>
    <locator row="64">Additive struck-string - single note</locator>
    <locator row="72">Additive struck-string - sustained fifth</locator>
    <locator row="80">Additive struck-string - 31-EDO C-E-G triad</locator>
    <locator row="88">Additive struck-string - C-E-G-A# harmonic 7th</locator>
    <locator row="96">Mellotron (tape+padsynth) - single note</locator>
    <locator row="104">Mellotron (tape+padsynth) - sustained fifth</locator>
    <locator row="112">Mellotron (tape+padsynth) - 31-EDO C-E-G triad</locator>
    <locator row="120">Mellotron (tape+padsynth) - C-E-G-A# harmonic 7th</locator>
    <locator row="128">PadSynth warm, NARROW bandwidth (8c) - triad, compare to row 176</locator>
    <locator row="136">PadSynth warm, WIDE bandwidth (80c) - triad, compare to row 176/128</locator>
    <locator row="144">PadSynth formant-vocal - single note</locator>
    <locator row="152">PadSynth bowed-ensemble - single note</locator>
    <locator row="160">PadSynth glass - single note</locator>
    <locator row="168">Additive piano in unison with SoundFont guitar</locator>
    <locator row="176">PadSynth warm (tuningMatched=on) - single note</locator>
    <locator row="184">PadSynth warm (tuningMatched=on) - sustained fifth</locator>
    <locator row="192">PadSynth warm (tuningMatched=on) - 31-EDO C-E-G triad</locator>
    <locator row="200">PadSynth warm (tuningMatched=on) - C-E-G-A# harmonic 7th</locator>
    <locator row="208">PadSynth choir-aah - single note, compare to row 216</locator>
    <locator row="216">PadSynth choir-ooh - single note, compare to row 208</locator>
    <locator row="224">PadSynth "Soft Pad" - single note</locator>
    <locator row="232">PadSynth "Bells" (untuned/detuned) - single note</locator>
    <locator row="240">PadSynth "Dual Strings" (octave-doubled) - single note</locator>
    <locator row="248">PadSynth "Saw Piano" - single note</locator>
    <locator row="256">PadSynth "Phased Choir" (choir-aah + phaser) - single note</locator>
    <locator row="264">PadSynth "Church Organ" (organ-pipe) - single note</locator>
    <locator row="272">PadSynth "Synth Brass" (brass.synth) - single note</locator>
    <locator row="280">Synth piano, tuningMatched=ON - plain C-E-G triad</locator>
    <locator row="288">Synth piano, tuningMatched=OFF - plain C-E-G triad, compare to row 280</locator>
    <locator row="296">Synth piano, tuningMatched=ON - quartal triad C D# F</locator>
    <locator row="304">Synth piano, tuningMatched=OFF - quartal triad C D# F, compare to row 296</locator>
    <locator row="312">Synth piano, tuningMatched=ON - quartal triad C Ebb F</locator>
    <locator row="320">Synth piano, tuningMatched=OFF - quartal triad C Ebb F, compare to row 312</locator>
  </locators>

  <arrangement>
    <!-- PadSynth keyboard (rows 0-31) -->
    <pattern track="0">
      <note row="0" value="C-4"/>
      <note row="6" value="off"/>
      <note row="8">C-4 G-4</note>
      <note row="14">off off</note>
      <note row="16">C-4 E-4 G-4</note>
      <note row="22">off off off</note>
      <note row="24">C-4 E-4 G-4 A#4</note>
      <note row="30">off off off off</note>
    </pattern>

    <!-- PadSynth warm, tuning-matched OFF (rows 32-63) -->
    <pattern track="1">
      <note row="32" value="C-4"/>
      <note row="38" value="off"/>
      <note row="40">C-4 G-4</note>
      <note row="46">off off</note>
      <note row="48">C-4 E-4 G-4</note>
      <note row="54">off off off</note>
      <note row="56">C-4 E-4 G-4 A#4</note>
      <note row="62">off off off off</note>
    </pattern>

    <!-- Additive struck-string (rows 64-95) -->
    <pattern track="7">
      <note row="64" value="C-4"/>
      <note row="70" value="off"/>
      <note row="72">C-4 G-4</note>
      <note row="78">off off</note>
      <note row="80">C-4 E-4 G-4</note>
      <note row="86">off off off</note>
      <note row="88">C-4 E-4 G-4 A#4</note>
      <note row="94">off off off off</note>
    </pattern>

    <!-- Mellotron (rows 96-127) -->
    <pattern track="8">
      <note row="96" value="C-4"/>
      <note row="102" value="off"/>
      <note row="104">C-4 G-4</note>
      <note row="110">off off</note>
      <note row="112">C-4 E-4 G-4</note>
      <note row="118">off off off</note>
      <note row="120">C-4 E-4 G-4 A#4</note>
      <note row="126">off off off off</note>
    </pattern>

    <!-- PadSynth warm, narrow bandwidth - triad only (rows 128-135) -->
    <pattern track="2">
      <note row="128">C-4 E-4 G-4</note>
      <note row="134">off off off</note>
    </pattern>

    <!-- PadSynth warm, wide bandwidth (80c) - triad only (rows 136-143) -->
    <pattern track="3">
      <note row="136">C-4 E-4 G-4</note>
      <note row="142">off off off</note>
    </pattern>

    <!-- PadSynth formant-vocal - single note (rows 144-151) -->
    <pattern track="4">
      <note row="144" value="C-4"/>
      <note row="150" value="off"/>
    </pattern>

    <!-- PadSynth bowed-ensemble - single note (rows 152-159) -->
    <pattern track="5">
      <note row="152" value="C-4"/>
      <note row="158" value="off"/>
    </pattern>

    <!-- PadSynth glass - single note (rows 160-167) -->
    <pattern track="6">
      <note row="160" value="C-4"/>
      <note row="166" value="off"/>
    </pattern>

    <!-- Additive piano in unison with the SoundFont guitar (rows 168-175) -
         the same short ascending phrase on both tracks simultaneously. -->
    <pattern track="9">
      <note row="168" value="C-4"/>
      <note row="170" value="D-4"/>
      <note row="172" value="E-4"/>
      <note row="174" value="G-4"/>
    </pattern>
    <pattern track="10">
      <note row="168" value="C-4"/>
      <note row="170" value="D-4"/>
      <note row="172" value="E-4"/>
      <note row="174" value="G-4"/>
    </pattern>

    <!-- PadSynth warm, tuning-matched ON (rows 176-207) - moved from track 0 -->
    <pattern track="11">
      <note row="176" value="C-4"/>
      <note row="182" value="off"/>
      <note row="184">C-4 G-4</note>
      <note row="190">off off</note>
      <note row="192">C-4 E-4 G-4</note>
      <note row="198">off off off</note>
      <note row="200">C-4 E-4 G-4 A#4</note>
      <note row="206">off off off off</note>
    </pattern>

    <!-- Choir aah vs. ooh, back to back for direct comparison (rows
         208-223) -->
    <pattern track="12">
      <note row="208" value="C-4"/>
      <note row="214" value="off"/>
    </pattern>
    <pattern track="13">
      <note row="216" value="C-4"/>
      <note row="222" value="off"/>
    </pattern>

    <!-- ZynAddSubFX-example reference points (rows 224-271) -->
    <pattern track="14">
      <note row="224" value="C-4"/>
      <note row="230" value="off"/>
    </pattern>
    <pattern track="15">
      <note row="232" value="C-4"/>
      <note row="238" value="off"/>
    </pattern>
    <pattern track="16">
      <note row="240" value="C-4"/>
      <note row="246" value="off"/>
    </pattern>
    <pattern track="17">
      <note row="248" value="C-4"/>
      <note row="254" value="off"/>

      <!-- tuningMatched showcase, ON half (rows 280-318) - see track 21
           for the OFF half at the interleaved rows between these. -->
      <note row="280">C-4 E-4 G-4</note>
      <note row="286">off off off</note>
      <note row="296">C-4 D#4 F-4</note>
      <note row="302">off off off</note>
      <note row="312">C-4 Ebb4 F-4</note>
      <note row="318">off off off</note>
    </pattern>
    <pattern track="18">
      <note row="256" value="C-4"/>
      <note row="262" value="off"/>
    </pattern>
    <pattern track="19">
      <note row="264" value="C-4"/>
      <note row="270" value="off"/>
    </pattern>
    <pattern track="20">
      <note row="272" value="C-4"/>
      <note row="278" value="off"/>
    </pattern>

    <!-- tuningMatched showcase, OFF half (rows 288-326) - interleaved
         between track 17's own ON-half rows above so playback alternates
         ON/OFF for each chord in turn: plain triad, then quartal C D# F,
         then quartal C Ebb F. -->
    <pattern track="21">
      <note row="288">C-4 E-4 G-4</note>
      <note row="294">off off off</note>
      <note row="304">C-4 D#4 F-4</note>
      <note row="310">off off off</note>
      <note row="320">C-4 Ebb4 F-4</note>
      <note row="326">off off off</note>
    </pattern>
  </arrangement>
</song>
