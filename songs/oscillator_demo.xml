<?xml version="1.0" encoding="UTF-8"?>
<!--
  Demo/listening song for the <padsynth>/<additive> oscillators and the
  hand-built library instruments (mellotron, additive piano). Every
  instrument here is constructed directly (envelope+padsynth/additive/
  tapeDegradation), not by referencing a GM taxonomy path - the one
  deliberate exception is the "guitarSf2" track in the final section,
  which exists specifically to compare the additive piano against a real
  SoundFont guitar, and needs an actual SoundFont loaded to be audible
  (silent/fallback-oscillator otherwise, which is harmless, just quiet).

  Render with:
    ./build/synth --render demo.wav songs/oscillator_demo.xml
  and scrub/listen against the <locators> below, or open it in the UI and
  use the arrangement overview's locator column (each marks ›).
-->
<song temperament="31edo" tempo="90" rowsPerBar="4" volume="1.0">
  <instruments>
    <!-- 0: PadSynth "keyboard" - a sparse, few-harmonic piano-like tone
         with a percussive envelope (near-instant attack, decaying all the
         way to silence, no sustain plateau) - long enough (2.0s) to stay
         audible across this file's 6-row-held-chord convention. Used
         first for the chord-testing sections since it's the clearest,
         most keys-like tone to judge a chord by. -->
    <envelope name="PadSynth Keyboard" attack="0.005" hold="0" decay="2.0" sustain="0.0" release="0.3">
      <padsynth preset="keyboard"/>
    </envelope>
    <!-- 1: PadSynth "strings", tuning-matched OFF - A/B against instrument
         11 (PadSynth strings, tuning-matched ON, moved to the end of this
         file) -->
    <envelope name="PadSynth Strings (unmatched)" attack="0.05" hold="0" decay="0.6" sustain="0.7" release="1.0">
      <padsynth preset="strings" tuningMatched="false"/>
    </envelope>
    <!-- 2: PadSynth "bells-3", a narrow-band bell-like tone. -->
    <envelope name="PadSynth Bells 3" attack="0.05" hold="0" decay="0.6" sustain="0.7" release="1.0">
      <padsynth preset="bells-3"/>
    </envelope>
    <!-- 3: PadSynth "dual-strings", a wide-band single-partial tone. -->
    <envelope name="PadSynth Dual Strings (wide)" attack="0.05" hold="0" decay="0.6" sustain="0.7" release="1.0">
      <padsynth preset="dual-strings"/>
    </envelope>
    <!-- 4: PadSynth "choir-pad4" -->
    <envelope name="PadSynth Choir Pad4" attack="0.4" hold="0" decay="0.4" sustain="0.85" release="1.0">
      <padsynth preset="choir-pad4"/>
    </envelope>
    <!-- 5: PadSynth "strings" - a simple, near-octave-doubled bowed
         string tone. -->
    <envelope name="PadSynth Strings" attack="0.3" hold="0" decay="0.4" sustain="0.85" release="0.8">
      <padsynth preset="strings"/>
    </envelope>
    <!-- 6: PadSynth "bells" -->
    <envelope name="PadSynth Bells (matched)" attack="0.02" hold="0" decay="0.8" sustain="0.5" release="1.2">
      <padsynth preset="bells"/>
    </envelope>
    <!-- 7: Additive "struck-string" -->
    <envelope name="Additive Struck-String" attack="0.005" hold="0" decay="1.5" sustain="0.3" release="0.5">
      <additive preset="struck-string"/>
    </envelope>
    <!-- 8: Mellotron - tape machine wrapping envelope+padsynth(strings): a
         Mellotron "strings" tape is a recording of a bowed string
         ensemble, the same real-world instrument family as "strings". -->
    <tapeDegradation name="Mellotron" preset="mellotron">
      <envelope attack="0.05" hold="0" decay="0.3" sustain="0.95" release="0.4">
        <padsynth preset="strings"/>
      </envelope>
    </tapeDegradation>
    <!-- 9: Additive piano - sustain 0, long decay so it never truncates the
         additive engine's own per-partial decay, short release. Overrides
         on top of struck-string (3-voice unison for a piano's own doubled/
         tripled strings per note, quieter/duller hammer attack, brighter
         tilt) matching src/instruments/InstrumentLibrary.cpp's own
         registerLibraryInstruments() - this song builds instruments
         directly rather than referencing that registration, so the two
         copies must be kept in sync by hand. -->
    <envelope name="Additive Piano" attack="0.005" hold="0" decay="8.0" sustain="0.0" release="0.3">
      <additive preset="struck-string" unisonVoices="3" attackNoiseLevel="0.04" tilt="-6"/>
    </envelope>
    <!-- 10: A real SoundFont guitar, for the unison comparison at the end -
         the one instrument here not built directly. -->
    <instrument name="SoundFont Guitar" from="guitar.acoustic.steel"/>
    <!-- 11: PadSynth "strings", tuning-matched partials (default) - moved
         here (was instrument 0) once instrument 0's own chord-testing slot
         was given to the new "keyboard" preset instead. -->
    <envelope name="PadSynth Strings (matched)" attack="0.05" hold="0" decay="0.6" sustain="0.7" release="1.0">
      <padsynth preset="strings"/>
    </envelope>
    <!-- 12: choir-pad4, wrapped in <multiply unisons="3"> for genuine
         ensemble-of-singers detuning/beating, which a single static table
         can't produce on its own. -->
    <multiply name="PadSynth Choir Pad4" unisons="3" detune="16" spread="0.5">
      <envelope attack="0.4" hold="0" decay="0.4" sustain="0.85" release="1.0">
        <padsynth preset="choir-pad4"/>
      </envelope>
    </multiply>
    <!-- 13: reserved - was a second, "ooh" vowel variant (choir-pad4-ooh);
         pulled since it didn't actually read as a distinct vowel, to be
         redone properly later. Silent for now (empty pattern below), kept
         as a valid instrument (a plain copy of instrument 12's own
         choir-pad4) rather than left referencing the removed preset. -->
    <multiply name="PadSynth Choir Pad4 (reserved)" unisons="3" detune="16" spread="0.5">
      <envelope attack="0.4" hold="0" decay="0.4" sustain="0.85" release="1.0">
        <padsynth preset="choir-pad4"/>
      </envelope>
    </multiply>

    <!-- 14-19: a further set of PadSynth character presets, each placed
         next to a plain envelope so its own spectral shape is easy to
         judge in isolation. -->

    <!-- 14: "Soft Pad" - a single pure partial, no upper harmonics at all -
         "soft" in the most literal spectral sense. -->
    <envelope name="PadSynth Soft Pad" attack="0.8" hold="0" decay="0.3" sustain="0.9" release="1.5">
      <padsynth preset="soft-pad"/>
    </envelope>

    <!-- 15: "Bells" - a small handful of dominant, non-scale-tuned
         partials, tuningMatched=false so those partials stay untempered -
         a real bell's own non-integer overtones read as dissonant against
         a fixed pitch the same way. Compare to instrument 6's own plain,
         tuning-matched Bells. -->
    <envelope name="PadSynth Bells" attack="0.02" hold="0" decay="1.0" sustain="0.3" release="1.5">
      <padsynth preset="bells" tuningMatched="false"/>
    </envelope>

    <!-- 16: "Dual Strings" - the strings tone wrapped in
         <multiply octaves="1">, layering a real octave-doubled voice on
         top rather than just widening the band. -->
    <multiply name="PadSynth Dual Strings" octaves="1" detune="6">
      <envelope attack="0.4" hold="0" decay="0.3" sustain="0.9" release="0.7">
        <padsynth preset="strings"/>
      </envelope>
    </multiply>

    <!-- 17: "Saw Piano" - a sustained "piano pad" character (holds at a
         substantial level rather than decaying to silence), unlike
         instrument 0's own percussive "keyboard" tone or instrument 9's
         additive piano (true per-partial decay) - three different takes
         on "piano". -->
    <envelope name="PadSynth Saw Piano" attack="0.005" hold="0" decay="0.3" sustain="0.85" release="0.4">
      <padsynth preset="saw-piano"/>
    </envelope>

    <!-- 18: "Phased Choir" - choir-pad4 wrapped directly in <phaser>, a
         faster and more obvious sweep than pad.halo's own slow-shimmer
         combination - the phaser itself is the point of comparison here.
         See docs/effects.md for <phaser>'s own attributes. -->
    <phaser name="PadSynth Phased Choir" stages="8" rate="0.35" minFreq="250" maxFreq="3000" feedback="0.5" mix="0.6">
      <envelope attack="0.4" hold="0" decay="0.4" sustain="0.85" release="1.0">
        <padsynth preset="choir-pad4"/>
      </envelope>
    </phaser>

    <!-- 19: "Church Organ" - a sparse drawbar-organ-style harmonic stack.
         Referenced directly (not through the taxonomy path, so this plays
         even when a real SoundFont organ is loaded and would otherwise
         win at organ.pipe itself). -->
    <envelope name="PadSynth Organ Pipe" attack="0.015" hold="0" decay="0.05" sustain="1.0" release="0.08">
      <padsynth preset="church-organ"/>
    </envelope>

    <!-- 20: Synth Brass - referenced straight from the library
         (InstrumentLibrary.cpp's own brass.synth registration), not
         rebuilt here, since it's a plain preset+envelope+multiply
         combination with nothing song-specific to demonstrate on top -
         unlike the additive piano/choir above, there's no divergent-copy
         risk to keep in sync by hand. -->
    <instrument name="PadSynth Synth Brass" from="brass.synth"/>

    <!-- 21: "PadSynth Keyboard (unmatched)" - instrument 0's own exact
         "keyboard" preset/envelope, tuningMatched="false" only - the same
         paired-instrument shape instrument 1/11 ("PadSynth Strings
         (unmatched)"/"PadSynth Strings (matched)") already established at
         the top of this file, applied to the synth piano (instrument 0, already used
         for every chord-testing section in this file) rather than the
         Saw Piano (instrument 17, a single-note comparison point against
         the additive piano, not built for chords). A plain triad can't
         fully make tuningMatched's own point either - see the new
         locators/patterns below (rows 280-325) for quartal triads that
         actually stress its partial-snapping behavior. -->
    <envelope name="PadSynth Keyboard (unmatched)" attack="0.005" hold="0" decay="2.0" sustain="0.0" release="0.3">
      <padsynth preset="keyboard" tuningMatched="false"/>
    </envelope>
  </instruments>

  <tracks>
    <track id="0" name="PadSynth Keyboard" instrument="0"/>
    <track id="1" name="PadSynth Strings (unmatched)" instrument="1"/>
    <track id="2" name="PadSynth Bells 3" instrument="2"/>
    <track id="3" name="PadSynth Dual Strings (wide)" instrument="3"/>
    <track id="4" name="PadSynth Choir Pad4" instrument="4"/>
    <track id="5" name="PadSynth Strings" instrument="5"/>
    <track id="6" name="PadSynth Bells (matched)" instrument="6"/>
    <track id="7" name="Additive Struck-String" instrument="7"/>
    <track id="8" name="Mellotron" instrument="8"/>
    <track id="9" name="Additive Piano" instrument="9"/>
    <track id="10" name="SoundFont Guitar" instrument="10"/>
    <track id="11" name="PadSynth Strings (matched)" instrument="11"/>
    <track id="12" name="PadSynth Choir Pad4 (unison)" instrument="12"/>
    <track id="13" name="PadSynth Choir Pad4 (reserved)" instrument="13"/>
    <track id="14" name="PadSynth Soft Pad" instrument="14"/>
    <track id="15" name="PadSynth Bells" instrument="15"/>
    <track id="16" name="PadSynth Dual Strings" instrument="16"/>
    <track id="17" name="PadSynth Saw Piano" instrument="17"/>
    <track id="18" name="PadSynth Phased Choir" instrument="18"/>
    <track id="19" name="PadSynth Organ Pipe" instrument="19"/>
    <track id="20" name="PadSynth Synth Brass" instrument="20"/>
    <track id="21" name="PadSynth Keyboard (unmatched)" instrument="21"/>
  </tracks>

  <locators>
    <locator row="0">PadSynth keyboard - single note</locator>
    <locator row="8">PadSynth keyboard - sustained fifth</locator>
    <locator row="16">PadSynth keyboard - 31-EDO C-E-G triad</locator>
    <locator row="24">PadSynth keyboard - C-E-G-A♯ harmonic 7th</locator>
    <locator row="32">PadSynth strings (tuningMatched=OFF) - single note</locator>
    <locator row="40">PadSynth strings (tuningMatched=OFF) - sustained fifth</locator>
    <locator row="48">PadSynth strings (tuningMatched=OFF) - 31-EDO C-E-G triad</locator>
    <locator row="56">PadSynth strings (tuningMatched=OFF) - C-E-G-A♯ harmonic 7th</locator>
    <locator row="64">Additive struck-string - single note</locator>
    <locator row="72">Additive struck-string - sustained fifth</locator>
    <locator row="80">Additive struck-string - 31-EDO C-E-G triad</locator>
    <locator row="88">Additive struck-string - C-E-G-A♯ harmonic 7th</locator>
    <locator row="96">Mellotron (tape+padsynth) - single note</locator>
    <locator row="104">Mellotron (tape+padsynth) - sustained fifth</locator>
    <locator row="112">Mellotron (tape+padsynth) - 31-EDO C-E-G triad</locator>
    <locator row="120">Mellotron (tape+padsynth) - C-E-G-A♯ harmonic 7th</locator>
    <locator row="128">PadSynth "Bells 3", a narrow-band tone - triad, compare to row 136</locator>
    <locator row="136">PadSynth "Dual Strings" (wide), a wide-band tone - triad, compare to row 128</locator>
    <locator row="144">PadSynth "Choir Pad4" - single note</locator>
    <locator row="152">PadSynth strings - single note</locator>
    <locator row="160">PadSynth "Bells" (tuning-matched) - single note</locator>
    <locator row="168">Additive piano in unison with SoundFont guitar</locator>
    <locator row="176">PadSynth strings (tuningMatched=on) - single note</locator>
    <locator row="184">PadSynth strings (tuningMatched=on) - sustained fifth</locator>
    <locator row="192">PadSynth strings (tuningMatched=on) - 31-EDO C-E-G triad</locator>
    <locator row="200">PadSynth strings (tuningMatched=on) - C-E-G-A♯ harmonic 7th</locator>
    <locator row="208">PadSynth choir-pad4 - single note (track 13 reserved, silent for now)</locator>
    <locator row="224">PadSynth "Soft Pad" - single note</locator>
    <locator row="232">PadSynth "Bells" (untuned/detuned) - single note</locator>
    <locator row="240">PadSynth "Dual Strings" (octave-doubled) - single note</locator>
    <locator row="248">PadSynth "Saw Piano" - single note</locator>
    <locator row="256">PadSynth "Phased Choir" (choir-pad4 + phaser) - single note</locator>
    <locator row="264">PadSynth "Church Organ" (organ-pipe) - single note</locator>
    <locator row="272">PadSynth "Synth Brass" (brass.synth) - single note</locator>
    <locator row="280">Synth piano, tuningMatched=ON - plain C-E-G triad</locator>
    <locator row="288">Synth piano, tuningMatched=OFF - plain C-E-G triad, compare to row 280</locator>
    <locator row="296">Synth piano, tuningMatched=ON - quartal triad C D♯ F</locator>
    <locator row="304">Synth piano, tuningMatched=OFF - quartal triad C D♯ F, compare to row 296</locator>
    <locator row="312">Synth piano, tuningMatched=ON - quartal triad C E𝄫 F</locator>
    <locator row="320">Synth piano, tuningMatched=OFF - quartal triad C E𝄫 F, compare to row 312</locator>
  </locators>

  <arrangement>
    <!-- PadSynth keyboard (rows 0-31) -->
    <pattern track="0">
      <note row="0" value="C-4"/>
      <note row="6" value="off"/>
      <note row="8">C-4 G-4</note>
      <note row="14">off off</note>
      <note row="16">C-4 E-4 G-4</note>
      <note row="22">off off off</note>
      <note row="24">C-4 E-4 G-4 A♯4</note>
      <note row="30">off off off off</note>

      <!-- tuningMatched showcase, ON half (rows 280-318) - see track 21
           for the OFF half at the interleaved rows between these. -->
      <note row="280">C-4 E-4 G-4</note>
      <note row="286">off off off</note>
      <note row="296">C-4 D♯4 F-4</note>
      <note row="302">off off off</note>
      <note row="312">C-4 E𝄫4 F-4</note>
      <note row="318">off off off</note>
    </pattern>

    <!-- PadSynth strings, tuning-matched OFF (rows 32-63) -->
    <pattern track="1">
      <note row="32" value="C-4"/>
      <note row="38" value="off"/>
      <note row="40">C-4 G-4</note>
      <note row="46">off off</note>
      <note row="48">C-4 E-4 G-4</note>
      <note row="54">off off off</note>
      <note row="56">C-4 E-4 G-4 A♯4</note>
      <note row="62">off off off off</note>
    </pattern>

    <!-- Additive struck-string (rows 64-95) -->
    <pattern track="7">
      <note row="64" value="C-4"/>
      <note row="70" value="off"/>
      <note row="72">C-4 G-4</note>
      <note row="78">off off</note>
      <note row="80">C-4 E-4 G-4</note>
      <note row="86">off off off</note>
      <note row="88">C-4 E-4 G-4 A♯4</note>
      <note row="94">off off off off</note>
    </pattern>

    <!-- Mellotron (rows 96-127) -->
    <pattern track="8">
      <note row="96" value="C-4"/>
      <note row="102" value="off"/>
      <note row="104">C-4 G-4</note>
      <note row="110">off off</note>
      <note row="112">C-4 E-4 G-4</note>
      <note row="118">off off off</note>
      <note row="120">C-4 E-4 G-4 A♯4</note>
      <note row="126">off off off off</note>
    </pattern>

    <!-- PadSynth Bells 3, narrow-band - triad only (rows 128-135) -->
    <pattern track="2">
      <note row="128">C-4 E-4 G-4</note>
      <note row="134">off off off</note>
    </pattern>

    <!-- PadSynth Dual Strings (wide), wide-band - triad only (rows 136-143) -->
    <pattern track="3">
      <note row="136">C-4 E-4 G-4</note>
      <note row="142">off off off</note>
    </pattern>

    <!-- PadSynth Choir Pad4 - single note (rows 144-151) -->
    <pattern track="4">
      <note row="144" value="C-4"/>
      <note row="150" value="off"/>
    </pattern>

    <!-- PadSynth strings - single note (rows 152-159) -->
    <pattern track="5">
      <note row="152" value="C-4"/>
      <note row="158" value="off"/>
    </pattern>

    <!-- PadSynth Bells (tuning-matched) - single note (rows 160-167) -->
    <pattern track="6">
      <note row="160" value="C-4"/>
      <note row="166" value="off"/>
    </pattern>

    <!-- Additive piano in unison with the SoundFont guitar (rows 168-175) -
         the same short ascending phrase on both tracks simultaneously. -->
    <pattern track="9">
      <note row="168" value="C-4"/>
      <note row="170" value="D-4"/>
      <note row="172" value="E-4"/>
      <note row="174" value="G-4"/>
    </pattern>
    <pattern track="10">
      <note row="168" value="C-4"/>
      <note row="170" value="D-4"/>
      <note row="172" value="E-4"/>
      <note row="174" value="G-4"/>
    </pattern>

    <!-- PadSynth strings, tuning-matched ON (rows 176-207) - moved from track 0 -->
    <pattern track="11">
      <note row="176" value="C-4"/>
      <note row="182" value="off"/>
      <note row="184">C-4 G-4</note>
      <note row="190">off off</note>
      <note row="192">C-4 E-4 G-4</note>
      <note row="198">off off off</note>
      <note row="200">C-4 E-4 G-4 A♯4</note>
      <note row="206">off off off off</note>
    </pattern>

    <!-- Choir Pad4 (rows 208-223; track 13 - reserved for a future "ooh"
         variant - stays silent, no notes) -->
    <pattern track="12">
      <note row="208" value="C-4"/>
      <note row="214" value="off"/>
    </pattern>

    <!-- Further PadSynth character presets (rows 224-271) -->
    <pattern track="14">
      <note row="224" value="C-4"/>
      <note row="230" value="off"/>
    </pattern>
    <pattern track="15">
      <note row="232" value="C-4"/>
      <note row="238" value="off"/>
    </pattern>
    <pattern track="16">
      <note row="240" value="C-4"/>
      <note row="246" value="off"/>
    </pattern>
    <pattern track="17">
      <note row="248" value="C-4"/>
      <note row="254" value="off"/>
    </pattern>
    <pattern track="18">
      <note row="256" value="C-4"/>
      <note row="262" value="off"/>
    </pattern>
    <pattern track="19">
      <note row="264" value="C-4"/>
      <note row="270" value="off"/>
    </pattern>
    <pattern track="20">
      <note row="272" value="C-4"/>
      <note row="278" value="off"/>
    </pattern>

    <!-- tuningMatched showcase, OFF half (rows 288-326) - interleaved
         between track 0's own ON-half rows above so playback alternates
         ON/OFF for each chord in turn: plain triad, then quartal C D♯ F,
         then quartal C E𝄫 F. -->
    <pattern track="21">
      <note row="288">C-4 E-4 G-4</note>
      <note row="294">off off off</note>
      <note row="304">C-4 D♯4 F-4</note>
      <note row="310">off off off</note>
      <note row="320">C-4 E𝄫4 F-4</note>
      <note row="326">off off off</note>
    </pattern>
  </arrangement>
</song>
