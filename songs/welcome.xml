<?xml version="1.0" encoding="UTF-8"?>
<song temperament="31edo" tempo="120" patternRows="8" volume="1.0">
  <instruments>
    <instrument from="bass.electric.finger"/>
  </instruments>
  <tracks>
    <track id="bass" instrument="0" azimuth="0" distance="1"/>
    <drumMachineTrack id="drums" azimuth="0" distance="1">
      <lane note="BD"/>
      <lane note="SD"/>
      <lane note="CH"/>
    </drumMachineTrack>
  </tracks>
  <clips>
    <trackClips track="drums">
      <clip name="verse" length="8">
        <pattern>
          <note row="0" velocity="100" value="BD"/>
          <note row="2" velocity="90" value="CH"/>
          <note row="4" velocity="100" value="SD"/>
          <note row="6" velocity="90" value="CH"/>
        </pattern>
      </clip>
      <clip name="fill" length="8">
        <pattern>
          <note row="0" velocity="100" value="SD"/>
          <note row="1" velocity="90" value="SD"/>
