      </clip>
    </trackClips>
  </clips>
  <scenes>
    <scene>
      <pattern track="drums">
        <note row="0" velocity="100" value="BD"/>
        <note row="4" velocity="100" value="SD"/>
      </pattern>
      <pattern track="bass">
        <note row="0" velocity="100" value="C-2"/>
      </pattern>
    </scene>
    <scene>
      <pattern track="drums">
        <note row="0" velocity="100" value="BD"/>
        <note row="2" velocity="90" value="CH"/>
      </pattern>
    </scene>
  </scenes>
</song>
