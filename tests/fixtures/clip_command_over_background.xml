<?xml version="1.0" encoding="UTF-8"?>
<!-- The same clip volume set (0LEC, about -6dB) with the section background
     setting the same track silent (0L00) on that row: the clip is applied
     after the background, so the clip wins and the note is audible.
     -->
<song temperament="12edo" tempo="120" rowsPerBar="1" volume="1.0">
  <instruments>
    <envelope attack="0.01" hold="0.3" decay="0.3" sustain="0.0" release="0.05">
      <oscillator type="saw"/>
    </envelope>
  </instruments>
  <tracks>
    <track id="0" instrument="0"/>
  </tracks>
  <clips>
    <trackClips track="0">
      <clip id="c0" loop="1">
        <pattern>
          <note row="0" velocity="80" value="C-4" />
          <command row="0" data="0LEC" />
        </pattern>
      </clip>
    </trackClips>
  </clips>
  <arrangement>
    <pattern track="0">
      <command row="0" data="0L00" />
    </pattern>
    <instances track="0">
      <instance row="0">c0</instance>
      <instance row="8">OFF</instance>
    </instances>
  </arrangement>
</song>
