<?xml version="1.0" encoding="UTF-8"?>
<!-- A single positioned NoiseVoice wrapped directly in an EnvelopeFilter (no
     NoteMultiplier), for ambisonic rendering: confirms TrackState::render(int
     frames)'s mismatch-encode logic correctly handles a transparent effect
     sitting directly above a single reduced (MONO) leaf voice - the
     voice's position must still come through in the master decode.
     Broadband pink noise, not a sine wave, for consistency with the other
     position/direction fixtures (see ambisonic_directions.xml). -->
<song temperament="12edo" tempo="120" patternRows="16" volume="1.0">
  <instruments>
    <envelope attack="0.02" hold="0.9" decay="0.08" sustain="0.0" release="0.02">
      <noise color="pink"/>
    </envelope>
  </instruments>
  <tracks>
    <track id="0" instrument="0" azimuth="90" elevation="0" distance="1"/>
  </tracks>
  <scenes>
    <scene>
      <pattern track="0">
        <note row="0" velocity="80" value="C-4" />
      </pattern>
    </scene>
  </scenes>
</song>
