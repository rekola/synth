<?xml version="1.0" encoding="UTF-8"?>
<!-- Denser-than-cardinal static direction grid for ambisonic rendering:
     azimuth stepped every 45 degrees around the full horizon (not just the
     4 cardinal compass points, which are too coarse to catch e.g. a sign-
     convention bug), plus straight up/down and a far-distance comparison.
     Each track fires its note on its own, well-separated row (4 rows apart
     at tempo 120 = 0.5s, envelope rings ~0.065s) so RenderTests can window
     each position's contribution independently in the final decoded
     output. -->
<song temperament="12edo" tempo="120" volume="1.0" randomization="0">
  <instruments>
    <envelope attack="0.005" hold="0.03" decay="0.02" sustain="0.0" release="0.01">
      <oscilator type="sine"/>
    </envelope>
  </instruments>
  <tracks>
    <track id="0" instrument="0" azimuth="0" elevation="0" distance="1"/>
    <track id="1" instrument="0" azimuth="45" elevation="0" distance="1"/>
    <track id="2" instrument="0" azimuth="90" elevation="0" distance="1"/>
    <track id="3" instrument="0" azimuth="135" elevation="0" distance="1"/>
    <track id="4" instrument="0" azimuth="180" elevation="0" distance="1"/>
    <track id="5" instrument="0" azimuth="-135" elevation="0" distance="1"/>
    <track id="6" instrument="0" azimuth="-90" elevation="0" distance="1"/>
    <track id="7" instrument="0" azimuth="-45" elevation="0" distance="1"/>
    <track id="8" instrument="0" azimuth="0" elevation="90" distance="1"/>
    <track id="9" instrument="0" azimuth="0" elevation="-90" distance="1"/>
    <track id="10" instrument="0" azimuth="0" elevation="0" distance="2"/>
  </tracks>
  <patterns>
    <pattern rows="48">
      <note row="0" track="0" velocity="80" value="C-4"/>
      <note row="4" track="1" velocity="80" value="C-4"/>
      <note row="8" track="2" velocity="80" value="C-4"/>
      <note row="12" track="3" velocity="80" value="C-4"/>
      <note row="16" track="4" velocity="80" value="C-4"/>
      <note row="20" track="5" velocity="80" value="C-4"/>
      <note row="24" track="6" velocity="80" value="C-4"/>
      <note row="28" track="7" velocity="80" value="C-4"/>
      <note row="32" track="8" velocity="80" value="C-4"/>
      <note row="36" track="9" velocity="80" value="C-4"/>
      <note row="40" track="10" velocity="80" value="C-4"/>
    </pattern>
  </patterns>
</song>
