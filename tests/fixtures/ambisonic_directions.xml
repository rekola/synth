<?xml version="1.0" encoding="UTF-8"?>
<!-- Denser-than-cardinal static direction grid for ambisonic rendering:
     azimuth stepped every 45 degrees around the full horizon (not just the
     4 cardinal compass points, which are too coarse to catch e.g. a sign-
     convention bug), plus straight up/down and a far-distance comparison.
     Each track fires its note on its own, well-separated row (12 rows
     apart at tempo 120 = 1.5s, envelope rings ~1.0s) so RenderTests can
     window each position's contribution independently in the final
     decoded output. Broadband pink noise, not a sine wave: this fixture
     includes straight up/down (elevation +-90), and a single-frequency
     tone can't convey height at all - real elevation perception (via the
     binaural SOFA-convolved decoder) depends on frequency-dependent pinna
     spectral cues that only a broadband signal exercises, and a full
     second of steady noise gives those cues enough duration to actually
     develop and be measured reliably (a short blip doesn't). -->
<song temperament="12edo" tempo="120" volume="1.0" randomization="0">
  <instruments>
    <envelope attack="0.02" hold="0.9" decay="0.08" sustain="0.0" release="0.02">
      <noise color="pink"/>
    </envelope>
  </instruments>
  <tracks>
    <track id="0" name="az0" instrument="0" azimuth="0" elevation="0" distance="1"/>
    <track id="1" name="az45" instrument="0" azimuth="45" elevation="0" distance="1"/>
    <track id="2" name="az90" instrument="0" azimuth="90" elevation="0" distance="1"/>
    <track id="3" name="az135"  instrument="0" azimuth="135" elevation="0" distance="1"/>
    <track id="4" name="az180" instrument="0" azimuth="180" elevation="0" distance="1"/>
    <track id="5" name="az-135" instrument="0" azimuth="-135" elevation="0" distance="1"/>
    <track id="6" name="az-90" instrument="0" azimuth="-90" elevation="0" distance="1"/>
    <track id="7" name="az-45" instrument="0" azimuth="-45" elevation="0" distance="1"/>
    <track id="8" name="az0el90" instrument="0" azimuth="0" elevation="90" distance="1"/>
    <track id="9" name="az0el-90" instrument="0" azimuth="0" elevation="-90" distance="1"/>
    <track id="10" name="az0dist2" instrument="0" azimuth="0" elevation="0" distance="2"/>
  </tracks>
  <patterns>
    <pattern rows="132">
      <note row="0" track="0" velocity="80" value="C-4"/>
      <note row="12" track="1" velocity="80" value="C-4"/>
      <note row="24" track="2" velocity="80" value="C-4"/>
      <note row="36" track="3" velocity="80" value="C-4"/>
      <note row="48" track="4" velocity="80" value="C-4"/>
      <note row="60" track="5" velocity="80" value="C-4"/>
      <note row="72" track="6" velocity="80" value="C-4"/>
      <note row="84" track="7" velocity="80" value="C-4"/>
      <note row="96" track="8" velocity="80" value="C-4"/>
      <note row="108" track="9" velocity="80" value="C-4"/>
      <note row="120" track="10" velocity="80" value="C-4"/>
    </pattern>
  </patterns>
</song>
