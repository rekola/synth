<?xml version="1.0" encoding="UTF-8"?>
<!-- A placed clip whose own pattern carries a volume set (0LEC, about
     -6dB) on the row its note starts: the rendered level halves against
     arrangement_instance_plays_its_own_content.xml, which is otherwise
     identical. -->
<song temperament="12edo" tempo="120" timeSignature="1/16" volume="1.0">
  <instruments>
    <envelope id="i1" attack="0.01" hold="0.3" decay="0.3" sustain="0.0" release="0.05">
      <oscillator type="saw"/>
    </envelope>
  </instruments>
  <tracks>
    <track id="0" instrument="i1"/>
  </tracks>
  <clips>
    <clip track="0" id="c0" loop="1">
      <pattern>
        <note row="0" velocity="80" value="C-4" />
        <command row="0" data="0LEC" />
      </pattern>
    </clip>
  </clips>
  <arrangement>
    <instance track="0" row="0" clip="c0"/>
    <instance track="0" row="8"/>
  </arrangement>
</song>
