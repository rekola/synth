<?xml version="1.0" encoding="UTF-8"?>
<!-- EnvelopeFilter wrapping a spread NoteMultiplier chord, for ambisonic
     rendering - the exact scenario that drove this feature's final
     design: an ADSR-enveloped spread pad. EnvelopeFilter must stay
     transparent (no getChildChannelConfiguration override) so
     NoteMultiplier still sees genuine AMBISONIC format and its sub-voices'
     spread survives being wrapped by the envelope above it. Four unison
     voices with real detune (a realistic pad-style spread), saw wave
     (sweetened by the multiplier's own detuning/spread, unlike the plain
     single-voice fixtures where a harsher wave would just sound harsh). -->
<song temperament="12edo" tempo="120" patternRows="8" volume="1.0">
  <instruments>
    <envelope attack="0.01" hold="0.2" decay="0.1" sustain="0.0" release="0.02">
      <multiply unisons="4" spread="0.5774" detune="20">
        <oscilator type="saw"/>
      </multiply>
    </envelope>
  </instruments>
  <tracks>
    <track id="0" instrument="0" azimuth="0" elevation="0" distance="1" extent="1"/>
  </tracks>
  <scenes>
    <scene>
      <pattern track="0">
        <note row="0" velocity="80" value="C-4" />
      </pattern>
    </scene>
  </scenes>
</song>
