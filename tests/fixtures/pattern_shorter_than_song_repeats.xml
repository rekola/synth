<?xml version="1.0" encoding="UTF-8"?>
<!-- A Pattern shorter than its own section's length repeats - see
     render_pattern_shorter_than_song_repeats(). This track's own <pattern>
     declares length="4" and only authors rows 0 (note on) and 2 (note
     off); rows 4-7 are never written at all, and must still play the
     identical on/off content as rows 0-3 (Pattern::getEffectiveRow()'s
     own modulo), not silence. -->
<song temperament="12edo" tempo="240" timeSignature="1/16" volume="1.0">
  <instruments>
    <oscillator id="i1" type="sine"/>
  </instruments>
  <tracks>
    <track id="0" instrument="i1" />
  </tracks>
  <arrangement>
    <pattern track="0">
      <note row="0" velocity="100" value="C-4" />
      <note row="2" value="OFF" />
      <note row="4" velocity="100" value="C-4" />
      <note row="6" value="OFF" />
    </pattern>
  </arrangement>
</song>
