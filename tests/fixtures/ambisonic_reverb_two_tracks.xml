<?xml version="1.0" encoding="UTF-8"?>
<!-- <reverb> wrapping two differently-positioned InstrumentTracks, for
     ambisonic rendering: confirms the reduce-to-real-stereo-then-
     re-encode path (ReverbState::render, Reverb.h/.cpp) actually
     produces a genuine, correctly-processed stereo-width reverb tail
     rather than a degraded fallback. Broadband pink noise, not a sine
     wave/single tone: a real reverb's response varies across the
     spectrum, so a broadband source exercises MVerb's actual behavior far
     more representatively than two discrete frequencies would. -->
<song temperament="12edo" tempo="120" patternRows="16" volume="1.0">
  <instruments>
    <envelope attack="0.02" hold="0.9" decay="0.08" sustain="0.0" release="0.02">
      <noise color="pink"/>
    </envelope>
  </instruments>
  <tracks>
    <reverb preset="stadium">
      <track id="0" instrument="0" azimuth="-90" distance="1"/>
      <track id="1" instrument="0" azimuth="90" distance="1"/>
    </reverb>
  </tracks>
  <patterns>
    <pattern>
      <note row="0" track="0" velocity="80" value="C-4"/>
      <note row="0" track="1" velocity="80" value="G-4"/>
    </pattern>
  </patterns>
</song>
