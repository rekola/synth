<?xml version="1.0" encoding="UTF-8"?>
<!-- Purpose-built for verify_launchpad_scene_row.py: two tracks, each with
     a real clip at Live-View index 7 (column 0 and column 1 - pad
     (0,0)/(1,0), y=0 being the *bottom* row of the 8-row grid, so the
     right-column scene-row convention (row = (cc_number - 19) / 10, CC19
     itself row 0) addresses index 7 - LaunchpadManager::triggerSceneRow()'s
     own y-flip comment). Both clips loop, so a real regression (only the
     first track's own column launching, the rest silently queuing instead
     of joining it) stays visible for as long as the check needs. -->
<song temperament="12edo" tempo="120" patternRows="16">
  <instruments>
    <instrument id="i1" from="string.bowed.ensemble.pizzicato" />
  </instruments>
  <tracks>
    <track id="0" instrument="i1" />
    <track id="1" instrument="i1" />
  </tracks>
  <clips>
    <clip track="0" name="p0" />
    <clip track="0" name="p1" />
    <clip track="0" name="p2" />
    <clip track="0" name="p3" />
    <clip track="0" name="p4" />
    <clip track="0" name="p5" />
    <clip track="0" name="p6" />
    <clip track="0" name="target0" length="8">
      <pattern>
        <note row="0" velocity="80" value="C-4" />
      </pattern>
    </clip>
    <clip track="1" name="q0" />
    <clip track="1" name="q1" />
    <clip track="1" name="q2" />
    <clip track="1" name="q3" />
    <clip track="1" name="q4" />
    <clip track="1" name="q5" />
    <clip track="1" name="q6" />
    <clip track="1" name="target1" length="8">
      <pattern>
        <note row="0" velocity="80" value="E-4" />
      </pattern>
    </clip>
  </clips>
  <arrangement>
  </arrangement>
</song>
