<?xml version="1.0" encoding="UTF-8"?>
<!-- Purpose-built for verify_launchpad_step_view_device.py: a
     PercussionTrack clip 96 rows long with BD hits at rows 5, 40 and 70 - the
     set of lit steps in the 32-step view tells which window a device is
     showing, with no need to read a playhead. -->
<song temperament="12edo" tempo="120" patternRows="16">
  <instruments>
    <envelope attack="0.001" hold="0.05" decay="0.05" sustain="0.0" release="0.05">
      <oscillator type="saw"/>
    </envelope>
  </instruments>
  <tracks>
    <percussionTrack id="0" instrument="0">
    </percussionTrack>
  </tracks>
  <clips>
    <trackClips track="0">
      <clip name="p0" />
      <clip name="p1" />
      <clip name="p2" />
      <clip name="p3" />
      <clip name="p4" />
      <clip name="p5" />
      <clip name="p6" />
      <clip name="Beat 1" loop="1" length="96">
        <pattern>
          <note row="5" velocity="80" value="BD" />
          <note row="40" velocity="80" value="BD" />
          <note row="70" velocity="80" value="BD" />
        </pattern>
      </clip>
    </trackClips>
  </clips>
  <arrangement>
  </arrangement>
</song>
