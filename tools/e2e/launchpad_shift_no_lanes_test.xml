<?xml version="1.0" encoding="UTF-8"?>
<!-- Purpose-built for verify_launchpad_shift_no_lanes.py: track 0 is a
     plain pitched InstrumentTrack (where the shared cursor starts by
     default) and track 1 is a *lane-less* PercussionTrack (no <lane>
     elements at all, so isStepSequenced() is false) with one populated
     clip at Session-view index 7 (pool indices 0-6 are empty fillers -
     pad (1,0) maps to track 1's clip index 7, y=0 being the bottom row -
     see LaunchpadManager::handleSessionPadEvent's own y-flip comment).
     Shift+pad on that clip still opens it for editing
     (Controller::toggleDrumClipFocus() doesn't gate on lane count) - the
     step grid every connected device switches to just shows completely
     empty (no lane to light anything), rather than either doing nothing
     or routing to the lane picker instead. -->
<song temperament="12edo" tempo="120" patternRows="16">
  <instruments>
    <envelope attack="0.001" hold="0.05" decay="0.05" sustain="0.0" release="0.05">
      <oscillator type="saw"/>
    </envelope>
  </instruments>
  <tracks>
    <track id="0" instrument="0" />
    <percussionTrack id="1" instrument="0" />
  </tracks>
  <clips>
    <trackClips track="1">
      <clip name="p0" />
      <clip name="p1" />
      <clip name="p2" />
      <clip name="p3" />
      <clip name="p4" />
      <clip name="p5" />
      <clip name="p6" />
      <clip name="Beat 1" loop="1" length="16">
        <pattern>
          <note row="0" velocity="80" value="BD" />
        </pattern>
      </clip>
    </trackClips>
  </clips>
  <arrangement>
  </arrangement>
</song>
