<?xml version="1.0" encoding="UTF-8"?>
<!-- Purpose-built for verify_launchpad_session.py: exactly one track (so
     x=0's column is unambiguous) and 8 clips (indices 0-7), with only the
     last one (7) populated - fake_launchpad_session.c's fixed press on pad
     (0,0) maps to clip index 7 (y=0 is the *bottom* row of the 8-row grid,
     so the one-past-the-visible-window formula lands on the last clip here
     - see LaunchpadManager::handleSessionPadEvent's own y-flip comment),
     which needs to actually exist rather than landing on an undefined
     slot a shorter clip list would leave there instead.
     The one scene starts with a distinct placeholder note (C-4) so an
     assign (Record Arm on, then the pad press) landing on this track/row
     is unambiguous: E-4 afterward. Clip index 7's own explicit length="8"
     matters when auditioning it live (verify_launchpad_stopclip.py) - a
     default (0, meaning "1" once clamped - see triggerClipStep()'s own
     current_length<=0 fallback) would re-trigger the same note on every
     single audition-clock step instead of looping normally, piling up
     voices and stalling the audio thread (confirmed - an XRUN followed by
     the simulated terminal going unresponsive). -->
<song temperament="12edo" tempo="120" patternRows="16">
  <instruments>
    <instrument from="string.bowed.ensemble.pizzicato" />
  </instruments>
  <tracks>
    <track id="0" instrument="0" />
  </tracks>
  <clips>
    <trackClips track="0">
      <clip name="p0" />
      <clip name="p1" />
      <clip name="p2" />
      <clip name="p3" />
      <clip name="p4" />
      <clip name="p5" />
      <clip name="p6" />
      <clip name="target" length="8">
        <pattern>
          <note row="0" velocity="80" value="E-4" />
        </pattern>
      </clip>
    </trackClips>
  </clips>
  <sections>
    <section>
      <pattern track="0">
        <note row="0" velocity="80" value="C-4" />
      </pattern>
    </section>
  </sections>
</song>
