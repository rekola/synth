<?xml version="1.0" encoding="UTF-8"?>
<!-- Purpose-built for verify_launchpad_paging_lockstep.py: a
     step-sequenced PercussionTrack clip 32 rows long with BD hits at rows
     0, 9, 18 and 27 - any 8-step window starting at a multiple of the step
     grid's scroll step (4) holds exactly one of them, each in a different
     column, so the one lit step in the BD lane tells which window a device
     is showing, with no need to read a playhead. -->
<song temperament="12edo" tempo="120" patternRows="16">
  <instruments>
    <envelope attack="0.001" hold="0.05" decay="0.05" sustain="0.0" release="0.05">
      <oscillator type="saw"/>
    </envelope>
  </instruments>
  <tracks>
    <percussionTrack id="0" instrument="0">
      <lane note="BD"/>
      <lane note="SD"/>
    </percussionTrack>
  </tracks>
  <clips>
    <trackClips track="0">
      <clip name="p0" />
      <clip name="p1" />
      <clip name="p2" />
      <clip name="p3" />
      <clip name="p4" />
      <clip name="p5" />
      <clip name="p6" />
      <clip name="Beat 1" loop="1" length="32">
        <pattern>
          <note row="0" velocity="80" value="BD" />
          <note row="9" velocity="80" value="BD" />
          <note row="18" velocity="80" value="BD" />
          <note row="27" velocity="80" value="BD" />
        </pattern>
      </clip>
    </trackClips>
  </clips>
  <sections>
    <section>
    </section>
  </sections>
</song>
