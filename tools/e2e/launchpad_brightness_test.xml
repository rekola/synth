<?xml version="1.0" encoding="UTF-8"?>
<!-- Purpose-built for verify_launchpad_note_brightness.py: one sine
     oscillator track (no envelope, so it sustains) holding one note at
     row 0 - playing the song makes that note sound, which brightens its
     Launchpad pad. -->
<song temperament="31edo" tempo="120" patternRows="8">
  <instruments>
    <oscillator id="i1" type="sine"/>
  </instruments>
  <tracks>
    <track id="0" instrument="i1"/>
  </tracks>
  <arrangement>
    <pattern track="0">
      <note row="0" velocity="100" value="C-4"/>
    </pattern>
  </arrangement>
</song>
