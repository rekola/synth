<?xml version="1.0" encoding="UTF-8"?>
<!-- Purpose-built for verify_launchpad_shift_stepgrid_pitched.py: a plain
     pitched InstrumentTrack (not PercussionTrack) with a song-wide major
     scale set, key C4 - Controller::toggleDrumClipFocus() no longer
     gates on track type beyond "percussion or pitched", so shift+pad
     opens this track's own clip for step-grid editing exactly the same
     way a PercussionTrack's does, its rows drawn from Song::
     getScaleDegrees() (LaunchpadManager::resolveStepGridLaneNotes()'s
     own comment) rather than a manually-picked lane list. One populated
     clip at Live-View index 7 (pool indices 0-6 are empty fillers -
     pad (0,0) maps to clip index 7, y=0 being the bottom row - see
     LaunchpadManager::handleLivePadEvent's own y-flip comment). -->
<song temperament="12edo" key="C4" scale="major" tempo="120" patternRows="16">
  <instruments>
    <envelope id="i1" attack="0.001" hold="0.05" decay="0.05" sustain="0.0" release="0.05">
      <oscillator type="saw"/>
    </envelope>
  </instruments>
  <tracks>
    <track id="0" instrument="i1" />
  </tracks>
  <clips>
    <clip track="0" name="p0" />
    <clip track="0" name="p1" />
    <clip track="0" name="p2" />
    <clip track="0" name="p3" />
    <clip track="0" name="p4" />
    <clip track="0" name="p5" />
    <clip track="0" name="p6" />
    <clip track="0" name="Beat 1" loop="1" length="16">
      <pattern>
        <note row="0" velocity="80" value="C4" />
      </pattern>
    </clip>
  </clips>
  <arrangement>
  </arrangement>
</song>
